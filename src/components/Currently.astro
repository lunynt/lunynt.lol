---
import { Icon } from "astro-icon/components";
import Section from "./Section.astro";
import { site } from "../config";

const enabled = site.discordId.length > 0;
---

{
  enabled && (
    <Section title="currently" data-presence data-discord-id={site.discordId}>
      <div class="custom" data-presence-custom hidden>
        <span class="custom-emoji" data-presence-custom-emoji />
        <span class="custom-text" data-presence-custom-text />
      </div>

      <div class="activities" data-presence-activities />

      <div class="prototype" data-presence-prototype hidden>
        <article class="rpc">
          <header class="rpc-head">
            <span class="rpc-app">
              <span
                class="rpc-icon"
                data-presence-icon-spotify
                hidden
                aria-hidden="true"
                style="color: #1db954"
              >
                <Icon name="simple-icons:spotify" size={16} />
              </span>
              <span
                class="rpc-icon"
                data-presence-icon-activity
                hidden
                aria-hidden="true"
              >
                <Icon name="lucide:gamepad-2" size={16} />
              </span>
              <span class="rpc-app-name" data-presence-header />
            </span>
          </header>

          <div class="rpc-body" data-presence-body hidden>
            <div class="rpc-art is-empty" data-presence-art>
              <span class="rpc-art-layer" data-presence-art-a />
              <span class="rpc-art-layer" data-presence-art-b />
            </div>
            <div class="rpc-info">
              <p class="rpc-title" data-presence-title />
              <p class="rpc-subtitle" data-presence-subtitle hidden />
              <div class="rpc-progress" data-presence-progress hidden>
                <span class="rpc-time" data-presence-elapsed>0:00</span>
                <span class="rpc-bar">
                  <span class="rpc-fill" data-presence-fill />
                </span>
                <span class="rpc-time" data-presence-duration>0:00</span>
              </div>
            </div>
          </div>
        </article>
      </div>

      <p class="source">
        live data via{" "}
        <a
          class="source-link"
          href="https://lanyard.rest"
          target="_blank"
          rel="noopener noreferrer"
        >
          lanyard.rest
        </a>
      </p>
    </Section>
  )
}

<style>
  .custom {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .custom.is-status {
    color: var(--color-muted);
  }

  .custom-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .rpc-emoji {
    width: 1.25rem;
    height: 1.25rem;
    object-fit: contain;
  }

  .custom:not([hidden]) + .activities:not(:empty) {
    margin-top: 1rem;
  }

  .activities {
    display: grid;
    gap: 0.75rem;
  }

  .activity-slot {
    overflow: hidden;
  }

  .rpc {
    background-color: var(--color-raised);
    border: 1px solid var(--color-line-strong);
    border-radius: 1rem;
    padding: 1rem 1.1rem 1.1rem;
  }

  .rpc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .rpc-app {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .rpc-icon {
    display: inline-flex;
    flex: none;
  }

  .rpc-app-name {
    font-size: 0.85rem;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rpc-body {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 0.85rem;
  }

  .rpc-art {
    position: relative;
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 0.6rem;
    flex: none;
    overflow: hidden;
    background-color: var(--color-elevated);
    transition:
      width 320ms ease,
      height 320ms ease,
      margin-right 320ms ease,
      opacity 320ms ease;
  }

  .rpc-art.is-empty {
    width: 0;
    height: 0;
    margin-right: -1rem;
    opacity: 0;
    pointer-events: none;
  }

  .rpc-art-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .rpc-art-layer.is-visible {
    opacity: 1;
  }

  .rpc-info {
    flex: 1;
    min-width: 0;
    padding-top: 0.15rem;
  }

  .rpc-title {
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rpc-subtitle {
    margin-top: 0.2rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rpc-progress {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.85rem;
  }

  .rpc-time {
    flex: none;
    color: var(--color-muted);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .rpc-bar {
    position: relative;
    flex: 1;
    height: 0.3rem;
    border-radius: 999px;
    background-color: var(--color-line-strong);
    overflow: hidden;
  }

  .rpc-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    border-radius: 999px;
    background-color: var(--color-ink);
  }

  .source {
    margin-top: 1.1rem;
    color: var(--color-faint);
    font-size: 0.75rem;
  }

  .source-link {
    color: var(--color-muted);
    transition: color 160ms ease;
  }

  .source-link:hover {
    color: var(--color-ink);
  }
</style>
