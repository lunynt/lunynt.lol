---
import { Image } from "astro:assets";
import banner from "../assets/banner.jpeg";
import Socials from "./Socials.astro";
import { profile } from "../config";
---

<section class="profile card" data-reveal>
  <div class="banner" data-banner>
    <div class="banner-media" data-banner-media>
      <Image
        src={banner}
        alt=""
        format="webp"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <div class="identity">
    <div class="avatar">
      <img
        src={profile.avatar}
        alt={profile.name}
        width="640"
        height="640"
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="identity-row">
      <div class="identity-text">
        <h1 class="name">{profile.name}</h1>
        <p class="pronunciation">{profile.pronunciation}</p>
        {
          profile.pronunciationHint && (
            <p class="hint">{profile.pronunciationHint}</p>
          )
        }
      </div>
      <div class="socials-wrap">
        <Socials align="start" />
      </div>
    </div>
  </div>
</section>

<div class="banner-shade" data-banner-shade />

<script>
  import "../scripts/banner";
</script>

<style>
  .profile {
    overflow: hidden;
  }

  .banner {
    position: relative;
    z-index: 45;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    touch-action: none;
    perspective: 900px;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    cursor: grab;
  }

  @media (min-width: 640px) {
    .banner {
      aspect-ratio: 16 / 5;
    }
  }

  .banner.is-active {
    cursor: grabbing;
  }

  .banner-media {
    position: absolute;
    inset: 0;
    transform: translate3d(var(--tx, 0px), var(--ty, 0px), 0)
      rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(var(--zoom, 1));
    will-change: transform;
  }

  .banner-shade {
    position: fixed;
    inset: 0;
    z-index: 40;
    background-color: rgba(10, 10, 11, 0.62);
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms ease;
  }

  .banner-shade.is-active {
    opacity: 1;
  }

  .identity {
    padding: 0 1.75rem 1.75rem;
  }

  .avatar {
    position: relative;
    z-index: 46;
    width: 7rem;
    height: 7rem;
    margin-top: -4rem;
    border-radius: 999px;
    border: 4px solid var(--color-canvas);
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .name {
    margin-top: 1rem;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .pronunciation {
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .hint {
    margin-top: 0.15rem;
    color: var(--color-faint);
    font-size: 0.85rem;
  }

  .identity-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .identity-text {
    min-width: 0;
  }

  .socials-wrap {
    flex: none;
  }
</style>
