# Supabase Postgres (connected to the project via the Vercel integration)
# the integration injects POSTGRES_URL, or paste the connection string
# from the Supabase dashboard (Project settings > Database)
POSTGRES_URL=

# optional salt for hashing visitor ips used by the rate limiter
RATE_LIMIT_SALT=

# admin dashboard (sign in with username and password, secret signs the session cookie)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET=
