# Supabase Postgres (connected to the project via the Vercel integration)
# the integration injects POSTGRES_URL, or paste the connection string
# from the Supabase dashboard (Project settings > Database)
POSTGRES_URL=

# optional salt for hashing visitor ips used by the rate limiter
RATE_LIMIT_SALT=

# Cloudflare Turnstile (guestbook + admin captcha)
# create a widget at https://dash.cloudflare.com > Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# admin dashboard (accounts live in the "admins" table in postgres)
# create or update one with: ADMIN_USERNAME=you ADMIN_PASSWORD=secret npm run admin:set
# the secret signs the session cookie
ADMIN_SECRET=
