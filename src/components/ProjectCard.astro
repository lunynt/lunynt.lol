---
import { Icon } from "astro-icon/components";
import type { Project } from "../config";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a
  class="project"
  href={project.url}
  target="_blank"
  rel="noopener noreferrer"
>
  <header class="head">
    <span class="icon" aria-hidden="true">
      <Icon name="simple-icons:github" size={16} />
    </span>
    <span class="repo">{project.name}</span>
    <span class="stats">
      <span class="stat">
        <Icon name="lucide:star" size={14} />
        <span>{project.stars}</span>
      </span>
      <span class="stat">
        <Icon name="lucide:git-fork" size={14} />
        <span>{project.forks}</span>
      </span>
    </span>
  </header>

  <p class="desc">{project.description}</p>

  <footer class="tags">
    <span class="lang">
      <span
        class="lang-dot"
        style={`background-color: ${project.languageColor}`}
      />
      {project.language}
    </span>
    {project.tags.map((tag) => <span class="tag">{tag}</span>)}
  </footer>
</a>

<style>
  .project {
    display: block;
    padding: 1rem 1.1rem;
    background-color: var(--color-elevated);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .project:hover {
    border-color: var(--color-line-strong);
    background-color: color-mix(
      in srgb,
      var(--color-elevated) 88%,
      var(--color-ink)
    );
  }

  .head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .icon {
    display: inline-flex;
    color: var(--color-muted);
  }

  .repo {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .repo::after {
    content: " ↗";
    opacity: 0;
    color: var(--color-muted);
    transition: opacity 160ms ease;
  }

  .project:hover .repo::after {
    opacity: 1;
  }

  .stats {
    margin-left: auto;
    display: flex;
    gap: 0.75rem;
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .stat {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .desc {
    margin-top: 0.55rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .tags {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .lang-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    flex: none;
  }

  .tag {
    font-size: 0.72rem;
    color: var(--color-muted);
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
  }
</style>
