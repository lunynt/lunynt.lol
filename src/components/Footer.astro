---
import { site, visitor } from "../config";

const year = new Date().getFullYear();
---

<footer class="footer" data-reveal>
  {
    visitor.enabled && (
      <p class="visitors" data-visitor-block hidden>
        <span class="count" data-visitor-count>0</span>
        <span>visits</span>
      </p>
    )
  }

  <p class="colophon">
    <span>{year} {site.name}</span>
    <span class="sep" aria-hidden="true">·</span>
    <a class="link" href="/privacy">privacy</a>
    <span class="sep" aria-hidden="true">·</span>
    <span>AGPL-3.0</span>
  </p>
</footer>

<style>
  .footer {
    padding: 1rem 0.35rem 2rem;
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    text-align: center;
  }

  .visitors {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .count {
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
    font-weight: 600;
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-faint);
  }

  .sep {
    color: var(--color-line-strong);
  }

  .link {
    color: var(--color-muted);
    transition: color 160ms ease;
  }

  .link:hover {
    color: var(--color-ink);
  }
</style>
