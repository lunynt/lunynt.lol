---
import { Icon } from "astro-icon/components";
import { site } from "../config";

interface Props {
  align?: "start" | "center";
}

const { align = "center" } = Astro.props;
---

{
  site.socials.length > 0 && (
    <ul class={`socials${align === "start" ? " is-start" : ""}`}>
      {site.socials.map((social) => (
        <li>
          <a
            class="social"
            href={social.href}
            target="_blank"
            rel="noopener noreferrer me"
            aria-label={social.label}
            title={social.label}
          >
            <Icon name={social.icon} size={20} />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    list-style: none;
  }

  .socials.is-start {
    justify-content: flex-start;
  }

  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: 999px;
    color: var(--color-muted);
    background-color: transparent;
    transition: color 160ms ease;
  }

  .social:hover {
    color: var(--color-ink);
  }
</style>
